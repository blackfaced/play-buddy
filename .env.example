# play-buddy 环境变量
#
# 复制成 .env 后按需修改（.env 不入库）。所有客户端可见的变量必须以 VITE_ 开头，
# 且**在构建时静态注入** —— 改完要重新 build 才生效，不是运行时读取。

# ---------------------------------------------------------------------
# study-buddy 融合层开关
# ---------------------------------------------------------------------
# 开启（默认，不设即为 true）：
#   运行时探测 /api/apps，探得到就开「学习换时长」奖励 + 会话上报；
#   探不到自动降级为纯玩。适合由 study-buddy 托管的在家部署。
#
# 关闭：
#   VITE_STUDY_BUDDY_ENABLED=false
#   彻底不探测、不发任何请求，也不会每次加载白等 2.5s 超时。
#   适合纯静态托管（外网访问时没有 study-buddy API）。
#
# 两种写法等价：手动设环境变量，或直接跑 npm run build:static
VITE_STUDY_BUDDY_ENABLED=false

# ---------------------------------------------------------------------
# 学习奖励日封顶（分钟）
# ---------------------------------------------------------------------
# 只在「学习换时长」生效时起作用（VITE_STUDY_BUDDY_ENABLED 不为 false 时）。
# 每完成 1 局学习游戏固定 +5 分钟，达标所需局数 = 封顶 ÷ 5。
#   10（默认）→ 练 2 局达标
#   15          → 练 3 局达标
# 取值必须为正数；非法值（0 / 负数 / 非数字）会回落到默认 10。
VITE_SB_REWARD_CAP_MIN=15
