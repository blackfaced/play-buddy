# play-buddy 环境变量
#
# 复制成 .env 后按需修改（.env 不入库）。所有客户端可见的变量必须以 VITE_ 开头，
# 且**在构建时静态注入** —— 改完要重新 build 才生效，不是运行时读取。

# ---------------------------------------------------------------------
# 学习奖励日封顶（分钟）
# ---------------------------------------------------------------------
# 玩「学习类」游戏（如糖果口算岛）通关可赚游戏时长，本机直接入账，
# 每日累计奖励不超过此封顶。
#   15（默认）
# 取值必须为正数；非法值（0 / 负数 / 非数字）会回落到默认 15。
VITE_REWARD_CAP_MIN=15
