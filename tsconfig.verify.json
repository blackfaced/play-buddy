{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "node_modules/.tmp-verify",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node"
    ],
    "moduleResolution": "node10"
  },
  "include": [
    "scripts/verify-towers.ts",
    "scripts/tune-salt.ts",
    "scripts/grid-exp.ts",
    "scripts/verify-win.ts",
    "scripts/verify-difficulty.ts",
    "scripts/verify-endless.ts",
    "scripts/afk-sweep.ts",
    "src/game/levels.ts",
    "src/game/tower.ts",
    "src/game/endless.ts",
    "src/game/engine.ts",
    "src/game/sound.ts",
    "scripts/probe-floaters.ts",
    "scripts/verify-math-island.ts",
    "src/mathisland/generate.ts",
    "scripts/verify-reward.ts",
    "src/lib/reward.ts",
    "scripts/verify-mul-drill.ts",
    "src/muldrill/pick-gen.ts",
    "scripts/verify-write.ts",
    "src/write/structure.ts",
    "src/write/strokes.ts",
    "scripts/verify-escape.ts",
    "src/escape/logic.ts"
  ]
}
